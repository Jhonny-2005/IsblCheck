<UserControl x:Class="IsblCheck.Views.Panels.StartPageView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:c="clr-namespace:IsblCheck.UI.Controls" xmlns:l="clr-namespace:IsblCheck.UI.Localization">
 <UserControl.Resources>
  <c:DataContextProxy x:Key="DataContextProxy" DataContext="{Binding}"/>
  <Style x:Key="StartCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Padding" Value="14,12"/>
   <Setter Property="Margin" Value="4"/>
   <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding Columns, RelativeSource={RelativeSource AncestorType={x:Type c:ResponsiveCardGrid}}}" Value="2">
     <Setter Property="Padding" Value="12,7"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="StartCardDetail" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding Columns, RelativeSource={RelativeSource AncestorType={x:Type c:ResponsiveCardGrid}}}" Value="2">
     <Setter Property="Visibility" Value="Collapsed"/>
    </DataTrigger>
   </Style.Triggers>
  </Style>
  <DataTemplate x:Key="RecentPath">
   <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
  </DataTemplate>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource CanvasBrush}">
  <StackPanel Margin="18,8" MaxWidth="1040" HorizontalAlignment="Stretch">
   <Border Background="#17233B" CornerRadius="14" Padding="16,10">
    <StackPanel>
     <TextBlock Text="Проверка кода ISBL" Foreground="White" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,3" TextWrapping="Wrap"/>
     <TextBlock Text="Выберите источник разработки для анализа кода и зависимостей."
                Foreground="#CBD5E1" FontSize="14" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
   <c:ResponsiveCardGrid Margin="-4,9,-4,0">
    <Button Command="{Binding OpenPackageCommand}" Style="{StaticResource StartCard}" ToolTip="Готовый пакет разработки" AutomationProperties.Name="Открыть пакет ISX">
     <StackPanel><TextBlock Text="ISX" FontWeight="Bold" FontSize="17" Foreground="{StaticResource AccentBrush}"/>
      <TextBlock Text="Открыть пакет" Margin="0,4,0,2" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="Готовый пакет разработки" Style="{StaticResource StartCardDetail}"/></StackPanel>
    </Button>
    <Button Command="{Binding OpenFolderCommand}" Style="{StaticResource StartCard}" ToolTip="Исходники из локальной папки" AutomationProperties.Name="Открыть папку DTU">
     <StackPanel><TextBlock Text="DTU" FontWeight="Bold" FontSize="17" Foreground="#6DDDD2"/>
      <TextBlock Text="Открыть папку" Margin="0,4,0,2" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="Исходники из локальной папки" Style="{StaticResource StartCardDetail}"/></StackPanel>
    </Button>
    <Button Command="{Binding OpenDatabaseCommand}" Style="{StaticResource StartCard}" ToolTip="Разработка из Directum" AutomationProperties.Name="Открыть базу Directum">
     <StackPanel><TextBlock Text="SQL" FontWeight="Bold" FontSize="17" Foreground="#C0A6FF"/>
      <TextBlock Text="Открыть базу" Margin="0,4,0,2" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="Разработка из Directum" Style="{StaticResource StartCardDetail}"/></StackPanel>
    </Button>
    <Button Command="{Binding OpenRouteExportCommand}" Style="{StaticResource StartCard}" ToolTip="XML/DAT и связанные IMG" AutomationProperties.Name="Открыть выгрузку маршрутов XML">
     <StackPanel><TextBlock Text="XML" FontWeight="Bold" FontSize="17" Foreground="#6DDDD2"/>
      <TextBlock Text="Открыть маршруты" Margin="0,4,0,2" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="XML/DAT и связанные IMG" Style="{StaticResource StartCardDetail}"/></StackPanel>
    </Button>
   </c:ResponsiveCardGrid>
   <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,9,0,0">
    <Border.Style>
     <Style TargetType="Border">
      <Style.Triggers>
       <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
         <Condition Binding="{Binding HasItems, ElementName=RecentPackages}" Value="False"/>
         <Condition Binding="{Binding HasItems, ElementName=RecentFolders}" Value="False"/>
        </MultiDataTrigger.Conditions>
        <Setter Property="Visibility" Value="Collapsed"/>
       </MultiDataTrigger>
      </Style.Triggers>
     </Style>
    </Border.Style>
    <StackPanel>
     <TextBlock Foreground="{StaticResource InkBrush}" Text="{l:Localization RECENT}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
     <ItemsControl x:Name="RecentPackages" ItemsSource="{Binding LastOpenedPackagesView}"><ItemsControl.ItemTemplate><DataTemplate>
      <Button Command="{Binding DataContext.OpenSpecifiedPackageCommand, Source={StaticResource DataContextProxy}}" CommandParameter="{Binding}"
              Content="{Binding}" ContentTemplate="{StaticResource RecentPath}" ToolTip="{Binding}" HorizontalContentAlignment="Stretch" Background="{StaticResource SurfaceBrush}" Margin="0,2"/>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <ItemsControl x:Name="RecentFolders" ItemsSource="{Binding LastOpenedFoldersView}"><ItemsControl.ItemTemplate><DataTemplate>
      <Button Command="{Binding DataContext.OpenSpecifiedFolderCommand, Source={StaticResource DataContextProxy}}" CommandParameter="{Binding}"
              Content="{Binding}" ContentTemplate="{StaticResource RecentPath}" ToolTip="{Binding}" HorizontalContentAlignment="Stretch" Background="{StaticResource SurfaceBrush}" Margin="0,2"/>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
