<UserControl x:Class="IsblCheck.Views.Panels.ReportViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:b="clr-namespace:IsblCheck.UI.Behaviors"
             xmlns:l="clr-namespace:IsblCheck.UI.Localization"
             xmlns:r="clr-namespace:IsblCheck.Core.Reports;assembly=IsblCheck.Core"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="600">
  <UserControl.Resources>
    <Style x:Key="ReportCellText" TargetType="TextBlock">
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="6,0"/>
    </Style>
    <Style x:Key="ReportAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="7,4"/>
      <Setter Property="Margin" Value="2"/>
      <Setter Property="MinHeight" Value="26"/>
    </Style>
    <Style x:Key="ReportFilter" TargetType="ToggleButton" BasedOn="{StaticResource FilterToggleStyle}">
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="MinHeight" Value="26"/>
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <WrapPanel Grid.Row="0" Background="{StaticResource SurfaceBrush}" Margin="4,4">
        <WrapPanel.Resources>
          <Style TargetType="Button" BasedOn="{StaticResource ReportAction}"/>
        </WrapPanel.Resources>
        <ToggleButton Style="{StaticResource ReportFilter}" IsChecked="{Binding IsErrorsShown, Mode=TwoWay}"
                      ToolTip="Показать или скрыть ошибки" AutomationProperties.Name="Ошибки">
          <StackPanel Orientation="Horizontal">
            <Image Source="/Resources/Error_20.png" Width="16" Height="16" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ErrorCount}" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource InkBrush}"/>
          </StackPanel>
        </ToggleButton>
        <ToggleButton Style="{StaticResource ReportFilter}" IsChecked="{Binding IsWarningsShown, Mode=TwoWay}"
                      ToolTip="Показать или скрыть предупреждения" AutomationProperties.Name="Предупреждения">
          <StackPanel Orientation="Horizontal">
            <Image Source="/Resources/Warning_20.png" Width="16" Height="16" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding WarningCount}" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource InkBrush}"/>
          </StackPanel>
        </ToggleButton>
        <ToggleButton Style="{StaticResource ReportFilter}" IsChecked="{Binding IsInformationsShown, Mode=TwoWay}"
                      ToolTip="Показать или скрыть сообщения" AutomationProperties.Name="Сообщения">
          <StackPanel Orientation="Horizontal">
            <Image Source="/Resources/Information_20.png" Width="16" Height="16" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding InformationCount}" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource InkBrush}"/>
          </StackPanel>
        </ToggleButton>
        <Button Command="{Binding ExportAsCsvCommand, Mode=OneWay}"
                Content="CSV" ToolTip="{l:Localization EXPORT_AS_CSV}"/>
        <Button Command="{Binding ExportAsHtmlCommand, Mode=OneWay}" ToolTip="Экспортировать полный отчёт в HTML">
          <TextBlock Text="HTML" FontWeight="SemiBold"/>
        </Button>
        <Button Command="{Binding ShowRecommendationCommand}" CommandParameter="{Binding SelectedItem, ElementName=ResultsGrid}"
                ToolTip="Открыть рекомендацию анализатора для выбранной строки">
          <TextBlock Text="Как исправить" FontWeight="SemiBold"/>
        </Button>
        <Button Command="{Binding ShowAiCommand}" ToolTip="Показать результаты ИИ"><TextBlock Text="ИИ · результат"/></Button>
        <Button Command="{Binding ReviewWithAiCommand}" CommandParameter="{Binding SelectedItem, ElementName=ResultsGrid}" ToolTip="Запросить рекомендации по выбранной проблеме и полному тексту вычисления">
          <TextBlock Text="ИИ · исправление" FontWeight="SemiBold"/>
        </Button>
        <TextBlock Text="{Binding NumericHintsStatus}" VerticalAlignment="Center" Margin="8,4,0,4" Foreground="{StaticResource MutedBrush}" ToolTip="F016 — необязательная подсказка о числовых литералах. Состояние зафиксировано на момент этой проверки."/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Label Content="Поиск" Target="{Binding ElementName=ResultsSearch}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
          <TextBox x:Name="ResultsSearch" Width="112" MinHeight="26" Padding="5,3" Margin="2" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Поиск по коду, описанию и имени документа" AutomationProperties.Name="Поиск по результатам"/>
        </StackPanel>
      </WrapPanel>

    <DataGrid x:Name="ResultsGrid" Grid.Row="1"
              ItemsSource="{Binding ReportMessages, Mode=OneWay, IsAsync=False}"
              AutoGenerateColumns="False"
              HorizontalGridLinesBrush="#344156"
              VerticalGridLinesBrush="#344156"
              SelectionUnit="FullRow"
              ScrollViewer.HorizontalScrollBarVisibility="Auto"
              RowHeight="30" ColumnHeaderHeight="30" IsReadOnly="True" CanUserAddRows="False" EnableColumnVirtualization="True" HeadersVisibility="Column"
              EnableRowVirtualization="True" 
              CanUserResizeRows="False">
      <DataGrid.ColumnHeaderStyle>
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
          <Setter Property="Padding" Value="5,3"/>
          <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
        </Style>
      </DataGrid.ColumnHeaderStyle>
      <DataGrid.Columns>
        <DataGridTemplateColumn Width="25" CanUserResize="False" 
                                CanUserSort="True" SortMemberPath="Severity">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Image HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="None">
                <Image.Style>
                  <Style TargetType="Image">
                    <Setter Property="Source" Value="{x:Null}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Severity, Mode=OneWay}" Value="{x:Static r:Severity.Error}">
                        <Setter Property="Source" Value="/Resources/Error_20.png"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Severity, Mode=OneWay}" Value="{x:Static r:Severity.Warning}">
                        <Setter Property="Source" Value="/Resources/Warning_20.png"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Severity, Mode=OneWay}" Value="{x:Static r:Severity.Information}">
                        <Setter Property="Source" Value="/Resources/Information_20.png"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Image.Style>
              </Image>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="{l:Localization MESSAGE_CODE}"
                            Width="48" MinWidth="43" ElementStyle="{StaticResource ReportCellText}"
                            Binding="{Binding Code, Mode=OneWay}"/>
        <DataGridTextColumn Header="{l:Localization MESSAGE_DESCRIPTION}"
                            Width="3*" MinWidth="104" ElementStyle="{StaticResource ReportCellText}"
                            Binding="{Binding Description, Mode=OneWay}"/>
        <DataGridTextColumn Header="{l:Localization MESSAGE_DOCUMENT}"
                            Width="2*" MinWidth="88" ElementStyle="{StaticResource ReportCellText}"
                            Binding="{Binding Document.Name, Mode=OneWay}"/>
        <DataGridTextColumn Header="{l:Localization MESSAGE_LINE}"
                            Width="55" MinWidth="54" ElementStyle="{StaticResource ReportCellText}"
                            Binding="{Binding Position.Line, Mode=OneWay}"/>
        <DataGridTextColumn Header="{l:Localization MESSAGE_COLUMN}"
                            Width="62" MinWidth="61" ElementStyle="{StaticResource ReportCellText}"
                            Binding="{Binding Position.Column, Mode=OneWay}"/>
      </DataGrid.Columns>
      <DataGrid.CellStyle>
        <Style TargetType="DataGridCell">
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
          <Setter Property="ToolTip" 
                  Value="{Binding RelativeSource={RelativeSource Self}, Path=Content.Text}"/>
        </Style>
      </DataGrid.CellStyle>
      <DataGrid.RowStyle>
        <Style TargetType="DataGridRow">
          <Setter Property="b:MouseDoubleClickBehavior.Command"
                  Value="{Binding DataContext.ShowReportMessageCommand,
                                  RelativeSource={RelativeSource FindAncestor, AncestorType=DataGrid},
                                  Mode=OneWay}"/>
          <Setter Property="b:MouseDoubleClickBehavior.CommandParameter"
                  Value="{Binding}"/>
          <Setter Property="b:EnterDownBehavior.Command"
                  Value="{Binding DataContext.ShowReportMessageCommand,
                                  RelativeSource={RelativeSource FindAncestor, AncestorType=DataGrid},
                                  Mode=OneWay}"/>
          <Setter Property="b:EnterDownBehavior.CommandParameter"
                  Value="{Binding}"/>
        </Style>
      </DataGrid.RowStyle>
    </DataGrid>
    <TextBlock Grid.Row="1" Text="{Binding EmptyStateText}" Foreground="{StaticResource MutedBrush}"
               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" TextWrapping="Wrap" IsHitTestVisible="False">
      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers><DataTrigger Binding="{Binding ReportMessages.IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
      </Style></TextBlock.Style>
    </TextBlock>
  </Grid>
</UserControl>
