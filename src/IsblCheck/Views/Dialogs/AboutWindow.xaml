<Window x:Class="IsblCheck.Views.Dialogs.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:l="clr-namespace:IsblCheck.UI.Localization"
        mc:Ignorable="d"
        Style="{StaticResource {x:Type Window}}" Language="ru-RU"
        Height="310" Width="440" MinWidth="260" MinHeight="175"
        WindowStartupLocation="CenterOwner"
        Title="{l:Localization ABOUT}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Image x:Name="AppLogo"
           Grid.Row="0"
           MaxHeight="180"
           Source="/Resources/AppLogo.png"
           Stretch="Uniform"/>
    <TextBox Grid.Row="1"
             BorderThickness="0"
             FontSize="14"
             TextWrapping="Wrap" Margin="0,8" IsReadOnly="True">
      <TextBox.Text>
        <MultiBinding StringFormat="{l:Localization PRODUCT_NAME_VERSION}">
          <Binding Path="ProductName" Mode="OneTime"/>
          <Binding Path="ProductVersion" Mode="OneTime"/>
        </MultiBinding>
      </TextBox.Text>
    </TextBox>
    <Button Grid.Row="2"
            Content="{l:Localization CLOSE}"
            Command="{Binding CloseCommand, Mode=OneTime}"
            HorizontalAlignment="Right"
            IsCancel="True" MinWidth="85" Margin="0,4,0,0"/>
  </Grid>
</Window>
