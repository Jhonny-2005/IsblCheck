<Window x:Class="IsblCheck.Views.Dialogs.DatabaseCredentialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:l="clr-namespace:IsblCheck.UI.Localization"
        xmlns:b="clr-namespace:IsblCheck.UI.Behaviors"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Style="{StaticResource {x:Type Window}}" Language="ru-RU"
        SizeToContent="Height" Width="580" MinWidth="420" MinHeight="240"
        WindowStartupLocation="CenterOwner"
        Title="{l:Localization OPEN_DATABASE_WINDOW_TITLE}">

  <Window.Resources>
    <Style TargetType="Label"><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  </Window.Resources>
  <DockPanel>
    <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="8,0,8,8">
      <Button Command="{Binding TestConnectionCommand, Mode=OneWay}"
              Content="{l:Localization TEST_CONNECTION}" Margin="4"/>
      <Button Command="{Binding CancelCommand, Mode=OneWay}" Content="{l:Localization CANCEL}"
              IsCancel="True" MinWidth="76" Margin="4"/>
      <Button Command="{Binding OkCommand, Mode=OneWay}" Content="{l:Localization OK}"
              IsDefault="True" MinWidth="76" Margin="4"/>
    </WrapPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="12,8,12,5">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <Label Grid.Row="0" Grid.Column="0"
           Content="{l:Localization DATABASE_SOURCE}"
           HorizontalAlignment="Left"
           VerticalAlignment="Center"/>
    <ComboBox Grid.Row="0" Grid.Column="1"
              ItemsSource="{Binding DatabaseSourcesView, Mode=OneWay}"
              IsEditable="True" Margin="5"
              Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}"
              Text="{Binding DatabaseSource, Mode=TwoWay,
                             ValidatesOnNotifyDataErrors=True,
                             UpdateSourceTrigger=PropertyChanged}">
      <i:Interaction.Triggers>
        <i:EventTrigger EventName="DropDownOpened">
          <i:InvokeCommandAction Command="{Binding FetchDatabaseSourcesCommand, Mode=OneWay}"/>
        </i:EventTrigger>
      </i:Interaction.Triggers>
    </ComboBox>
    <Button Grid.Row="0" Grid.Column="2"
            Command="{Binding RefreshDatabaseSourcesCommand, Mode=OneWay}"
            Content="{l:Localization REFRESH}"
            Margin="5"/>

    <Label Grid.Row="1" Grid.Column="0"
           Content="{l:Localization AUTH_TYPE}"
           HorizontalAlignment="Left"
           VerticalAlignment="Center"/>
    <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
              Margin="5" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}"
              SelectedValue="{Binding IntegratedSecurity, Mode=TwoWay}"
              SelectedValuePath="Tag">
      <ComboBoxItem Content="Windows-аутентификация">
        <ComboBoxItem.Tag>
          <sys:Boolean>True</sys:Boolean>
        </ComboBoxItem.Tag>
      </ComboBoxItem>
      <ComboBoxItem Content="SQL-аутентификация">
        <ComboBoxItem.Tag>
          <sys:Boolean>False</sys:Boolean>
        </ComboBoxItem.Tag>
      </ComboBoxItem>
    </ComboBox>

    <Label Grid.Row="2" Grid.Column="0"
           Content="{l:Localization USER_NAME}"
           HorizontalAlignment="Left"
           VerticalAlignment="Center"/>
    <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
             Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}"
             Text="{Binding UserName, Mode=TwoWay,
                            ValidatesOnNotifyDataErrors=True,
                            UpdateSourceTrigger=PropertyChanged}"
             VerticalContentAlignment="Center"
             MinHeight="22" Margin="5">
      <TextBox.Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding IntegratedSecurity, Mode=OneWay}" Value="True">
              <Setter Property="IsEnabled" Value="False"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBox.Style>
    </TextBox>

    <Label Grid.Row="3" Grid.Column="0"
           Content="{l:Localization PASSWORD}"
           HorizontalAlignment="Left"
           VerticalAlignment="Center"/>
    <PasswordBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                 VerticalContentAlignment="Center"
                 Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}"
                 MinHeight="22" Margin="5">
      <PasswordBox.Style>
        <Style TargetType="PasswordBox">
          <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
          <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
          <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
          <Setter Property="Padding" Value="10,8"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding IntegratedSecurity, Mode=OneWay}" Value="True">
              <Setter Property="IsEnabled" Value="False"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </PasswordBox.Style>
      <i:Interaction.Behaviors>
        <b:PasswordBehavior Password="{Binding Password, Mode=OneWay}"/>
      </i:Interaction.Behaviors>
    </PasswordBox>

    <Label Grid.Row="4" Grid.Column="0"
           Content="{l:Localization DATABASE}"
           HorizontalAlignment="Left"
           VerticalAlignment="Center"/>
    <ComboBox Grid.Row="4" Grid.Column="1"
              ItemsSource="{Binding DatabasesView, Mode=OneWay}"
              IsEditable="True" Margin="5"
              Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}"
              Text="{Binding Database, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
      <i:Interaction.Triggers>
        <i:EventTrigger EventName="DropDownOpened">
          <i:InvokeCommandAction Command="{Binding FetchDatabasesCommand, Mode=OneWay}"/>
        </i:EventTrigger>
      </i:Interaction.Triggers>
    </ComboBox>
    <Button Grid.Row="4" Grid.Column="2"
            Command="{Binding RefreshDatabasesCommand, Mode=OneWay}"
            Content="{l:Localization REFRESH}"
            Margin="5"/>

    <CheckBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="5,4,5,8"
              Foreground="{StaticResource InkBrush}" IsChecked="{Binding TrustServerCertificate, Mode=TwoWay}"
              ToolTip="Включайте только для доверенного тестового сервера; подлинность сертификата не проверяется.">
      <TextBlock Text="Доверять сертификату сервера без проверки" TextWrapping="Wrap"/>
    </CheckBox>
    <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding ConnectionStatus}" TextWrapping="Wrap"
               Foreground="{StaticResource MutedBrush}" Margin="5,0"
               AutomationProperties.LiveSetting="Polite"/>
  </Grid>
    </ScrollViewer>
  </DockPanel>
  <i:Interaction.Behaviors>
    <b:DialogResultBehavior DialogResult="{Binding DialogResult, Mode=OneWay}"/>
  </i:Interaction.Behaviors>
</Window>
