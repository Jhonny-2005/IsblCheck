<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\bin\IsblCheck\$(Configuration)\</OutputPath>
    <UseWPF>true</UseWPF>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <RootNamespace>IsblCheck</RootNamespace>
    <AssemblyName>IsblCheck</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <ApplicationIcon>Resources\App.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" />
    <PackageReference Include="AvalonEdit" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Extended.Wpf.Toolkit" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="NLog" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="WindowsAPICodePackShell" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IsblCheck.Core\IsblCheck.Core.csproj" />
    <ProjectReference Include="..\IsblCheck.Context.Application\IsblCheck.Context.Application.csproj" />
    <ProjectReference Include="..\IsblCheck.Context.Development\IsblCheck.Context.Development.csproj" />
    <ProjectReference Include="..\IsblCheck.Reports\IsblCheck.Reports.csproj" />
    <ProjectReference Include="..\IsblCheck.BaseRules\IsblCheck.BaseRules.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\ProductInfo.cs" Link="Properties\ProductInfo.cs" />
    <Compile Include="**\*.cs" Exclude="obj\**;bin\**" />
    <Page Include="**\*.xaml" Exclude="obj\**;bin\**" />
    <Resource Include="Resources\**\*" />
    <EmbeddedResource Include="Properties\Resources.resx">
      <LogicalName>IsblCheck.Properties.Resources.resources</LogicalName>
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup><None Update="NLog.config" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>

  <Target Name="CopyRulesAssembly" AfterTargets="Build">
    <MakeDir Directories="$(OutputPath)Rules" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\IsblCheck.BaseRules\IsblCheck.BaseRules.csproj"
             Targets="GetTargetPath" Properties="Configuration=$(Configuration)" RemoveProperties="RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_RulesAssembly" />
    </MSBuild>
    <Copy SourceFiles="@(_RulesAssembly)" DestinationFolder="$(OutputPath)Rules" />
  </Target>

  <Target Name="PublishRulesAssembly" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)Rules" />
    <Copy SourceFiles="$(OutputPath)Rules\IsblCheck.BaseRules.dll" DestinationFolder="$(PublishDir)Rules" />
  </Target>
</Project>
