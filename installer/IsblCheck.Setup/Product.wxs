        <File Id="F_zh_Hans_Xceed_Wpf_AvalonDock_resources_dll" Source="$(var.ArtifactsDir)zh-Hans\Xceed.Wpf.AvalonDock.resources.dll" KeyPath="yes" Checksum="yes" />
      </Component>
      <Component Id="C_zh_Hant_Microsoft_Data_SqlClient_resources_dll" Guid="*" Directory="D_zh_Hant">
        <File Id="F_zh_Hant_Microsoft_Data_SqlClient_resources_dll" Source="$(var.ArtifactsDir)zh-Hant\Microsoft.Data.SqlClient.resources.dll" KeyPath="yes" Checksum="yes" />
      </Component>
    </ComponentGroup>
    <!-- Правила анализатора. -->
    <ComponentGroup Id="Rules" Directory="RulesDir">
      <Component Id="IsblCheck.BaseRules.dll" Guid="*">
        <File Id="IsblCheck.BaseRules.dll" Source="$(var.ArtifactsDir)Rules\IsblCheck.BaseRules.dll" KeyPath="yes" Checksum="yes" />
      </Component>
    </ComponentGroup>
    <!-- Ярлыки в главном меню. -->
    <Component Id="ApplicationShortcuts" Guid="*" Directory="ApplicationProgramsFolder">
      <!-- Ярлык для запуска. -->
      <Shortcut Id="ApplicationStartMenuShortcut" Name="$(var.ProductName)" Description="$(var.ProductName)" Target="[#IsblCheck.exe]" WorkingDirectory="INSTALLDIR" Directory="ApplicationProgramsFolder" />
      <!-- Ярлык для удаления. -->
      <Shortcut Id="UninstallProduct" Name="Uninstall $(var.ProductName)" Description="Uninstalls $(var.ProductName)" Target="[System64Folder]msiexec.exe" Arguments="/x [ProductCode]" Directory="ApplicationProgramsFolder" />
      <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Microsoft\$(var.ProductName)" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Product>
</Wix>
